  "CaseNote": [
    {
      "note_id": "NOTE-G2-022-001",
      "case_id": "G2-022",
      "note_type": "admission",
      "note_text": "The longitudinal extract includes warfarin (Warfarin Sodium 5 MG Oral Tablet) for a recorded indication. Other products: Warfarin Sodium 5 MG Oral Tablet. There was no chronic daily bleeding at baseline. Overt bleeding began within the day before arrival and was not the patient's usual pattern. No new nonsteroidal drug was identified. The bleeding itself was the acute event on chronic anticoagulation. Heart rate was 114 and blood pressure was 96/58. Hemoglobin was 9.2 g/dL. INR was 4.1. Warfarin was held.",
      "provenance": "cliniproof_episode_generated"
    },
    {
      "note_id": "NOTE-G2-022-002",
      "case_id": "G2-022",
      "note_type": "hospital_course",
      "note_text": "Esophagogastroduodenoscopy was performed after resuscitation and showed gastric ulcer with a clean base. Hemostasis was achieved or the lesion was already flat. The source above was assigned only after endoscopy. The admitting problem was bleeding, not that finished source. Warfarin remained held. One unit of red cells was given. Pantoprazole was started for the upper source. Hemoglobin nadir was 7.4 g/dL and the pre-discharge value was 9.0 g/dL. Heart rate fell to 78 and blood pressure was 122/70. INR fell to 1.6. No further melena or hematochezia occurred. The patient was eating and hemodynamically stable. The anticoagulation restart decision was still unsigned. Gastroenterology and anticoagulation follow-up were arranged, with a hemoglobin check.",
      "provenance": "cliniproof_episode_generated"
    }
  ],
